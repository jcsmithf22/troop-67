---
import OatmealLayout from "@/layouts/OatmealLayout.astro";

import AnnouncementBadge from "@/components/elements/announcement-badge.astro";
import ButtonLink from "@/components/elements/button-link.astro";
import Link from "@/components/elements/link.astro";
import Logo from "@/components/elements/logo.astro";
import LogoGrid from "@/components/elements/logo-grid.astro";
import PlainButtonLink from "@/components/elements/plain-button-link.astro";
import Screenshot from "@/components/elements/screenshot.astro";
import SoftButtonLink from "@/components/elements/soft-button-link.astro";
import ArrowNarrowRightIcon from "@/components/icons/arrow-narrow-right-icon.astro";
import ChevronIcon from "@/components/icons/chevron-icon.astro";
import CallToActionSimple from "@/components/sections/call-to-action-simple.astro";
import Faq from "@/components/sections/faq.astro";
import FAQsTwoColumnAccordion from "@/components/sections/faqs-two-column-accordion.astro";
import Feature from "@/components/sections/feature.astro";
import FeaturesTwoColumnWithDemos from "@/components/sections/features-two-column-with-demos.astro";
import HeroLeftAlignedWithDemo from "@/components/sections/hero-left-aligned-with-demo.astro";
import Plan from "@/components/sections/plan.astro";
import PricingMultiTier from "@/components/sections/pricing-multi-tier.astro";
import Stat from "@/components/sections/stat.astro";
import StatsWithGraph from "@/components/sections/stats-with-graph.astro";
import Testimonial from "@/components/sections/testimonial.astro";
import TestimonialThreeColumnGrid from "@/components/sections/testimonials-three-column-grid.astro";
---

<OatmealLayout>
  <!-- Hero -->
  <HeroLeftAlignedWithDemo id="hero" headline="Forge your path. Determine your future. Embrace leadership.">
<!--     <AnnouncementBadge
      slot="eyebrow"
      href="#"
      text="Oatmeal raises 80M Series A funding"
      cta="Learn more"
    /> -->
    <p slot="subheadline">
      Simplify your shared inbox, collaborate effortlessly, and give every customer a reply that feels personal — even if
      it was generated by a bot.
    </p>
    <div slot="cta" class="flex items-center gap-4">
      <ButtonLink href="#" size="lg">Start free trial</ButtonLink>
      <PlainButtonLink href="#" size="lg">See how it works <ArrowNarrowRightIcon /></PlainButtonLink>
    </div>
    <Fragment slot="demo">
      <Screenshot class="rounded-md lg:hidden" wallpaper="green" placement="bottom-right">
        <img
          src="/oatmeal/img/screenshots/1-left-1670-top-1408.webp"
          alt=""
          width="1670"
          height="1408"
          class="bg-white/75 md:hidden dark:hidden"
        />
        <img
          src="/oatmeal/img/screenshots/1-color-olive-left-1670-top-1408.webp"
          alt=""
          width="1670"
          height="1408"
          class="bg-black/75 not-dark:hidden md:hidden"
        />
        <img
          src="/oatmeal/img/screenshots/1-left-2000-top-1408.webp"
          alt=""
          width="2000"
          height="1408"
          class="bg-white/75 max-md:hidden dark:hidden"
        />
        <img
          src="/oatmeal/img/screenshots/1-color-olive-left-2000-top-1408.webp"
          alt=""
          width="2000"
          height="1408"
          class="bg-black/75 not-dark:hidden max-md:hidden"
        />
      </Screenshot>
      <Screenshot class="rounded-lg max-lg:hidden" wallpaper="green" placement="bottom">
        <img src="/oatmeal/img/screenshots/1.webp" alt="" class="bg-white/75 dark:hidden" width="3440" height="1990" />
        <img
          class="bg-black/75 not-dark:hidden"
          src="/oatmeal/img/screenshots/1-color-olive.webp"
          alt=""
          width="3440"
          height="1990"
        />
      </Screenshot>
    </Fragment>
    <LogoGrid slot="footer">
      <Logo>
        <img src="/oatmeal/img/logos/9-color-black-height-32.svg" class="dark:hidden" alt="" width="51" height="32" />
        <img
          src="/oatmeal/img/logos/9-color-white-height-32.svg"
          class="bg-black/75 not-dark:hidden"
          alt=""
          width="51"
          height="32"
        />
      </Logo>
      <Logo>
        <img src="/oatmeal/img/logos/10-color-black-height-32.svg" class="dark:hidden" alt="" width="70" height="32" />
        <img
          src="/oatmeal/img/logos/10-color-white-height-32.svg"
          class="bg-black/75 not-dark:hidden"
          alt=""
          width="70"
          height="32"
        />
      </Logo>
      <Logo>
        <img src="/oatmeal/img/logos/11-color-black-height-32.svg" class="dark:hidden" alt="" width="100" height="32" />
        <img
          src="/oatmeal/img/logos/11-color-white-height-32.svg"
          class="bg-black/75 not-dark:hidden"
          alt=""
          width="100"
          height="32"
        />
      </Logo>
      <Logo>
        <img src="/oatmeal/img/logos/12-color-black-height-32.svg" class="dark:hidden" alt="" width="85" height="32" />
        <img
          src="/oatmeal/img/logos/12-color-white-height-32.svg"
          class="bg-black/75 not-dark:hidden"
          alt=""
          width="85"
          height="32"
        />
      </Logo>
      <Logo>
        <img src="/oatmeal/img/logos/13-color-black-height-32.svg" class="dark:hidden" alt="" width="75" height="32" />
        <img
          src="/oatmeal/img/logos/13-color-white-height-32.svg"
          class="bg-black/75 not-dark:hidden"
          alt=""
          width="75"
          height="32"
        />
      </Logo>
      <Logo>
        <img src="/oatmeal/img/logos/8-color-black-height-32.svg" class="dark:hidden" alt="" width="85" height="32" />
        <img
          src="/oatmeal/img/logos/8-color-white-height-32.svg"
          class="bg-black/75 not-dark:hidden"
          alt=""
          width="85"
          height="32"
        />
      </Logo>
    </LogoGrid>
  </HeroLeftAlignedWithDemo>

  <!-- Features -->
  <FeaturesTwoColumnWithDemos
    id="features"
    eyebrow="Powerful features"
    headline="Everything you need to deliver personal, organized, and delightful support."
  >
    <p slot="subheadline">
      Work smarter, reply faster, and keep every customer conversation right where it belongs — in one simple inbox.
    </p>
    <Fragment slot="features">
      <Feature headline="Shared Inbox">
        <Screenshot slot="demo" wallpaper="purple" placement="bottom-right">
          <img
            src="/oatmeal/img/screenshots/1-left-1000-top-800.webp"
            alt=""
            class="bg-white/75 sm:hidden dark:hidden"
            width="1000"
            height="800"
          />
          <img
            src="/oatmeal/img/screenshots/1-color-olive-left-1000-top-800.webp"
            alt=""
            class="bg-black/75 not-dark:hidden sm:hidden"
            width="1000"
            height="800"
          />
          <img
            src="/oatmeal/img/screenshots/1-left-1800-top-660.webp"
            alt=""
            class="bg-white/75 max-sm:hidden lg:hidden dark:hidden"
            width="1800"
            height="660"
          />
          <img
            src="/oatmeal/img/screenshots/1-color-olive-left-1800-top-660.webp"
            alt=""
            class="bg-black/75 not-dark:hidden max-sm:hidden lg:hidden"
            width="1800"
            height="660"
          />
          <img
            src="/oatmeal/img/screenshots/1-left-1300-top-1300.webp"
            alt=""
            class="bg-white/75 max-lg:hidden xl:hidden dark:hidden"
            width="1300"
            height="1300"
          />
          <img
            src="/oatmeal/img/screenshots/1-color-olive-left-1300-top-1300.webp"
            alt=""
            class="bg-black/75 not-dark:hidden max-lg:hidden xl:hidden"
            width="1300"
            height="1300"
          />
          <img
            src="/oatmeal/img/screenshots/1-left-1800-top-1250.webp"
            alt=""
            class="bg-white/75 max-xl:hidden dark:hidden"
            width="1800"
            height="1250"
          />
          <img
            src="/oatmeal/img/screenshots/1-color-olive-left-1800-top-1250.webp"
            alt=""
            class="bg-black/75 not-dark:hidden max-xl:hidden"
            width="1800"
            height="1250"
          />
        </Screenshot>
        <p slot="subheadline">
          Keep every customer conversation in one clean, collaborative inbox. A single source of truth is much easier to
          ignore.
        </p>
        <Link slot="cta" href="#">See how it works <ArrowNarrowRightIcon /></Link>
      </Feature>
      <Feature headline="Inbox Agent">
        <Screenshot slot="demo" wallpaper="blue" placement="bottom-left">
          <img
            src="/oatmeal/img/screenshots/1-right-1000-top-800.webp"
            alt=""
            class="bg-white/75 sm:hidden dark:hidden"
            width="1000"
            height="800"
          />
          <img
            src="/oatmeal/img/screenshots/1-color-olive-right-1000-top-800.webp"
            alt=""
            class="bg-black/75 not-dark:hidden sm:hidden"
            width="1000"
            height="800"
          />
          <img
            src="/oatmeal/img/screenshots/1-right-1800-top-660.webp"
            alt=""
            class="bg-white/75 max-sm:hidden lg:hidden dark:hidden"
            width="1800"
            height="660"
          />
          <img
            src="/oatmeal/img/screenshots/1-color-olive-right-1800-top-660.webp"
            alt=""
            class="bg-black/75 not-dark:hidden max-sm:hidden lg:hidden"
            width="1800"
            height="660"
          />
          <img
            src="/oatmeal/img/screenshots/1-right-1300-top-1300.webp"
            alt=""
            class="bg-white/75 max-lg:hidden xl:hidden dark:hidden"
            width="1300"
            height="1300"
          />
          <img
            src="/oatmeal/img/screenshots/1-color-olive-right-1300-top-1300.webp"
            alt=""
            class="bg-black/75 not-dark:hidden max-lg:hidden xl:hidden"
            width="1300"
            height="1300"
          />
          <img
            src="/oatmeal/img/screenshots/1-right-1800-top-1250.webp"
            alt=""
            class="bg-white/75 max-xl:hidden dark:hidden"
            width="1800"
            height="1250"
          />
          <img
            src="/oatmeal/img/screenshots/1-color-olive-right-1800-top-1250.webp"
            alt=""
            class="bg-black/75 not-dark:hidden max-xl:hidden"
            width="1800"
            height="1250"
          />
        </Screenshot>
        <p slot="subheadline">
          Get valuable context without having to read through your customer's long, angry email thread.
        </p>
        <Link slot="cta" href="#">See how it works <ArrowNarrowRightIcon /></Link>
      </Feature>
    </Fragment>
  </FeaturesTwoColumnWithDemos>

  <!-- Stats -->
  <StatsWithGraph
    id="stats"
    eyebrow="Built for scale"
    headline="The inbox powering customer conversations everywhere."
  >
    <p slot="subheadline">
      Oatmeal helps teams deliver personal, organized, and fast customer support across the world. From small startups to
      enterprise teams, we process millions of messages each month — using a massive network of low wage workers stationed
      around the globe.
    </p>
    <Stat stat="2M+" text="Emails manually processed every week across thousands of teams." />
    <Stat stat="99.98%" text="Uptime — because your customers never stop complaining." />
  </StatsWithGraph>

  <!-- Testimonial -->
  <TestimonialThreeColumnGrid id="testimonial" headline="What our customers are saying">
    <p slot="subheadline">We've given these customers a significant discount in exchange for their honest reviews.</p>
    <Testimonial name="Jordan Rogers" byline="Founder at Anomaly">
      <p slot="quote">
        Oatmeal has completely transformed our customer support operations. To be fair, we weren't doing any customer
        support at all so the bar was pretty low.
      </p>
      <img
        slot="img"
        src="/oatmeal/img/avatars/10-size-160.webp"
        alt=""
        class="not-dark:bg-white/75 dark:bg-black/75"
        width="160"
        height="160"
      />
    </Testimonial>
    <Testimonial name="Lynn Marshall" byline="Founder at Pine Labs">
      <p slot="quote">
        We use Oatmeal's automation features to make cancellation requests disappear into a black hole, improving our
        retention rates by over 300%.
      </p>
      <img
        slot="img"
        src="/oatmeal/img/avatars/15-size-160.webp"
        alt=""
        class="not-dark:bg-white/75 dark:bg-black/75"
        width="160"
        height="160"
      />
    </Testimonial>
    <Testimonial name="Rajat Singh" byline="Head of Support at Concise">
      <p slot="quote">
        I've been using the spare time that Oatmeal has freed up to work not just one, but two other jobs, all while
        hitting my core KPIs. My bosses have no idea.
      </p>
      <img
        slot="img"
        src="/oatmeal/img/avatars/13-size-160.webp"
        alt=""
        class="not-dark:bg-white/75 dark:bg-black/75"
        width="160"
        height="160"
      />
    </Testimonial>
    <Testimonial name="John Walters" byline="CPO at Orbital">
      <p slot="quote">
        Oatmeal has given us key insights into how much our customers absolutely hate using our product and how we can
        improve it to stop them from leaving us.
      </p>
      <img
        slot="img"
        src="/oatmeal/img/avatars/12-size-160.webp"
        alt=""
        class="not-dark:bg-white/75 dark:bg-black/75"
        width="160"
        height="160"
      />
    </Testimonial>
    <Testimonial name="Noah Gold" byline="CEO at Looply">
      <p slot="quote">
        As a solo founder, Oatmeal has been a lifesaver. It makes it look like Looply is an actual company with multiple
        employees, when in reality it's just me and an AI.
      </p>
      <img
        slot="img"
        src="/oatmeal/img/avatars/11-size-160.webp"
        alt=""
        class="not-dark:bg-white/75 dark:bg-black/75"
        width="160"
        height="160"
      />
    </Testimonial>
    <Testimonial name="Mark Levinson" byline="COO at Quirk">
      <p slot="quote">
        Thanks to Oatmeal, we've managed to cut our support costs in half by laying off dozens of employees, while still
        improving response times and customer satisfaction.
      </p>
      <img
        slot="img"
        src="/oatmeal/img/avatars/14-size-160.webp"
        alt=""
        class="not-dark:bg-white/75 dark:bg-black/75"
        width="160"
        height="160"
      />
    </Testimonial>
  </TestimonialThreeColumnGrid>

  <!-- FAQs -->
  <FAQsTwoColumnAccordion id="faqs" headline="Questions & Answers">
    <Faq
      id="faq-1"
      question="Do I need a credit card to start the free trial?"
      answer="Yes, but don't worry, you won't be charged until the trial period is over. We won't send you an email reminding you when this happens because we are really hoping you'll forget and we can keep charging you until your cards expires"
    />
    <Faq
      id="faq-2"
      question="Can my whole team use the same inbox?"
      answer="Yes, the more the merrier! Oatmeal works best when your entire company has access. We will charge you per additional seat, but we won't tell you about this until you get your invoice."
    />
    <Faq
      id="faq-3"
      question="Is the AI agent actually a bunch of people in India?"
      answer="Not just India! We have people in lots of countries around the world pretending to be an AI, including some that are currently under sanctions, so we can't legally mention them here."
    />
    <Faq
      id="faq-4"
      question="Does Oatmeal replace my email client?"
      answer="Absolutely. The idea is that we transition you away from email entirely, so you become completely dependent on our service. Like a parasite living off a host."
    />
  </FAQsTwoColumnAccordion>

  <!-- Pricing -->
  <PricingMultiTier id="pricing" headline="Pricing to fit your business needs.">
    <Fragment slot="plans">
      <Plan
        name="Starter"
        price="$12"
        period="/mo"
        features={[
          "Shared inbox for up to 2 mailboxes",
          "Tagging & assignment",
          "Private notes",
          "Automatic replies",
          "Email support",
        ]}
      >
        <p slot="subheadline">Small teams getting started with shared inboxes</p>
        <SoftButtonLink slot="cta" href="#" size="lg">Start free trial</SoftButtonLink>
      </Plan>
      <Plan
        name="Growth"
        price="$49"
        period="/mo"
        badge="Most popular"
        features={[
          "Everything in Starter",
          "Inbox Agent",
          "Unlimited mailboxes",
          "Collision detection",
          "Snippets and templates",
          "Reporting dashboard",
          "Slack integration",
        ]}
      >
        <p slot="subheadline">Growing teams needing collaboration and insights</p>
        <ButtonLink slot="cta" href="#" size="lg">Start free trial</ButtonLink>
      </Plan>
      <Plan
        name="Pro"
        price="$299"
        period="/mo"
        features={[
          "Everything in Growth",
          "Custom roles & permissions",
          "Automation engine",
          "API access",
          "SLA tracking",
          "SSO support",
          "SOC 2 compliance",
        ]}
      >
        <p slot="subheadline">Support-focused organizations and larger teams</p>
        <SoftButtonLink slot="cta" href="#" size="lg">Start free trial</SoftButtonLink>
      </Plan>
    </Fragment>
  </PricingMultiTier>

  <!-- Call To Action -->
  <CallToActionSimple id="call-to-action" headline="Ready to make customer support feel simple again?">
    <p slot="subheadline">
      Join hundreds of teams using Oatmeal to deliver faster, friendlier email support — using a massive network of low
      wage workers stationed around the globe
    </p>
    <div slot="cta" class="flex items-center gap-4">
      <ButtonLink href="#" size="lg">Start free trial</ButtonLink>
      <PlainButtonLink href="#" size="lg">Book a demo <ChevronIcon /></PlainButtonLink>
    </div>
  </CallToActionSimple>
</OatmealLayout>
