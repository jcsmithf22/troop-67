---
import OatmealLayout from "@/layouts/OatmealLayout.astro";
import Screenshot from "@/components/oatmeal/Screenshot.astro";
import TestimonialCard from "@/components/oatmeal/TestimonialCard.astro";

const logos = [9, 10, 11, 12, 13, 8];
const testimonials = [
  ["Oatmeal has completely transformed our customer support operations. To be fair, we weren't doing any customer support at all so the bar was pretty low.", "10", "Jordan Rogers", "Founder at Anomaly"],
  ["We use Oatmeal's automation features to make cancellation requests disappear into a black hole, improving our retention rates by over 300%.", "15", "Lynn Marshall", "Founder at Pine Labs"],
  ["I've been using the spare time that Oatmeal has freed up to work not just one, but two other jobs, all while hitting my core KPIs. My bosses have no idea.", "13", "Rajat Singh", "Head of Support at Concise"],
  ["Oatmeal has given us key insights into how much our customers absolutely hate using our product and how we can improve it to stop them from leaving us.", "12", "John Walters", "CPO at Orbital"],
  ["As a solo founder, Oatmeal has been a lifesaver. It makes it look like Looply is an actual company with multiple employees, when in reality it's just me and an AI.", "11", "Noah Gold", "CEO at Looply"],
  ["Thanks to Oatmeal, we've managed to cut our support costs in half by laying off dozens of employees, while still improving response times and customer satisfaction.", "14", "Mark Levinson", "COO at Quirk"],
];
const faqs = [
  ["Do I need a credit card to start the free trial?", "Yes, but don't worry, you won't be charged until the trial period is over. We won't send you an email reminding you when this happens because we are really hoping you'll forget and we can keep charging you until your cards expires"],
  ["Can my whole team use the same inbox?", "Yes, the more the merrier! Oatmeal works best when your entire company has access. We will charge you per additional seat, but we won't tell you about this until you get your invoice."],
  ["Is the AI agent actually a bunch of people in India?", "Not just India! We have people in lots of countries around the world pretending to be an AI, including some that are currently under sanctions, so we can't legally mention them here."],
  ["Does Oatmeal replace my email client?", "Absolutely. The idea is that we transition you away from email entirely, so you become completely dependent on our service. Like a parasite living off a host."],
];
const plans = [
  ["Starter", "$12", "Small teams getting started with shared inboxes", ["Shared inbox for up to 2 mailboxes", "Tagging & assignment", "Private notes", "Automatic replies", "Email support"]],
  ["Growth", "$49", "Growing teams needing collaboration and insights", ["Everything in Starter", "Inbox Agent", "Unlimited mailboxes", "Collision detection", "Snippets and templates", "Reporting dashboard", "Slack integration"]],
  ["Pro", "$299", "Support-focused organizations and larger teams", ["Everything in Growth", "Custom roles & permissions", "Automation engine", "API access", "SLA tracking", "SSO support", "SOC 2 compliance"]],
];
---

<OatmealLayout>
  <!-- HeroLeftAlignedWithDemo -->
  <section id="hero" class="py-16">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-16 px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex flex-col gap-32">
        <div class="flex flex-col items-start gap-6">
          <a href="#" class="group relative inline-flex max-w-full gap-x-3 overflow-hidden rounded-md bg-olive-950/5 px-3.5 py-2 text-sm/6 text-olive-950 hover:bg-olive-950/10 max-sm:flex-col sm:items-center sm:rounded-full sm:px-3 sm:py-0.5 dark:bg-white/5 dark:text-white dark:inset-ring-1 dark:inset-ring-white/5 dark:hover:bg-white/10">
            <span class="text-pretty sm:truncate">Oatmeal raises 80M Series A funding</span>
            <span class="h-3 w-px bg-olive-950/20 max-sm:hidden dark:bg-white/10"></span>
            <span class="inline-flex shrink-0 items-center gap-2 font-semibold text-olive-950 dark:text-white">Learn more <svg width="5" height="8" viewBox="0 0 5 8" fill="currentColor" class="inline-block shrink-0"><path fill-rule="evenodd" clip-rule="evenodd" d="M.22.22a.75.75 0 011.06 0l3.25 3.25a.75.75 0 010 1.06L1.28 7.78A.75.75 0 01.22 6.72L2.94 4 .22 1.28a.75.75 0 010-1.06z"></path></svg></span>
          </a>
          <h1 class="max-w-5xl font-display text-5xl/12 tracking-[-0.04em] text-balance text-olive-950 sm:text-[4rem]/16 dark:text-white">Customer support that feels like a conversation.</h1>
          <div class="flex max-w-3xl flex-col gap-4 text-lg/8 text-olive-700 dark:text-olive-400">
            <p>Simplify your shared inbox, collaborate effortlessly, and give every customer a reply that feels personal — even if it was generated by a bot.</p>
          </div>
          <div class="flex items-center gap-4">
            <a href="#" class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full bg-olive-950 px-4 py-2 text-sm/7 font-medium text-white hover:bg-olive-800 dark:bg-olive-300 dark:text-olive-950 dark:hover:bg-olive-200">Start free trial</a>
            <a href="#" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full px-4 py-2 text-sm/7 font-medium text-olive-950 hover:bg-olive-950/10 dark:text-white dark:hover:bg-white/10">See how it works <svg width="13" height="7" viewBox="0 0 13 7" fill="none" stroke-width="1" class="inline-block"><path d="M12.5049 3.49512L.504883 3.49512" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 6.5L12.5 3.5L9.5.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
          </div>
        </div>

        <Screenshot class="rounded-md lg:hidden" wallpaper="green" placement="bottom-right">
          <img src="/oatmeal/img/screenshots/1-left-1670-top-1408.webp" alt="" width="1670" height="1408" class="bg-white/75 md:hidden dark:hidden" />
          <img src="/oatmeal/img/screenshots/1-color-olive-left-1670-top-1408.webp" alt="" width="1670" height="1408" class="bg-black/75 not-dark:hidden md:hidden" />
          <img src="/oatmeal/img/screenshots/1-left-2000-top-1408.webp" alt="" width="2000" height="1408" class="bg-white/75 max-md:hidden dark:hidden" />
          <img src="/oatmeal/img/screenshots/1-color-olive-left-2000-top-1408.webp" alt="" width="2000" height="1408" class="bg-black/75 not-dark:hidden max-md:hidden" />
        </Screenshot>
        <Screenshot class="rounded-lg max-lg:hidden" wallpaper="green" placement="bottom">
          <img src="/oatmeal/img/screenshots/1.webp" alt="" width="3440" height="1990" class="bg-white/75 dark:hidden" />
          <img src="/oatmeal/img/screenshots/1-color-olive.webp" alt="" width="3440" height="1990" class="bg-black/75 not-dark:hidden" />
        </Screenshot>
      </div>
      <div class="mx-auto grid w-full grid-cols-2 place-items-center gap-x-6 gap-y-10 sm:grid-cols-3 sm:gap-x-10 lg:mx-auto lg:inline-grid lg:auto-cols-fr lg:grid-flow-col lg:grid-cols-1 lg:gap-12">
        {logos.map((logo) => (
          <span class="flex h-8 items-stretch">
            <img src={`/oatmeal/img/logos/${logo}-color-black-height-32.svg`} alt="" class="dark:hidden" />
            <img src={`/oatmeal/img/logos/${logo}-color-white-height-32.svg`} alt="" class="not-dark:hidden" />
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- FeaturesTwoColumnWithDemos -->
  <section id="features" class="py-16">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 sm:gap-16 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex max-w-2xl flex-col gap-6">
        <div class="flex flex-col gap-2">
          <div class="text-sm/7 font-semibold text-olive-700 dark:text-olive-400">Powerful features</div>
          <h2 class="font-display text-3xl/9 font-medium tracking-[-0.03em] text-pretty text-olive-950 sm:text-[2.5rem]/10 dark:text-white">Everything you need to deliver personal, organized, and delightful support.</h2>
        </div>
        <div class="text-base/7 text-pretty text-olive-700 dark:text-olive-400"><p>Work smarter, reply faster, and keep every customer conversation right where it belongs — in one simple inbox.</p></div>
      </div>
      <div class="grid grid-cols-1 gap-2 lg:grid-cols-2">
        <div class="rounded-lg bg-olive-950/2.5 p-2 dark:bg-white/5">
          <div class="relative overflow-hidden rounded-sm dark:after:absolute dark:after:inset-0 dark:after:rounded-sm dark:after:outline-1 dark:after:-outline-offset-1 dark:after:outline-white/10">
            <Screenshot wallpaper="purple" placement="bottom-right">
              <img src="/oatmeal/img/screenshots/1-left-1000-top-800.webp" alt="" width="1000" height="800" class="bg-white/75 sm:hidden dark:hidden" />
              <img src="/oatmeal/img/screenshots/1-color-olive-left-1000-top-800.webp" alt="" width="1000" height="800" class="bg-black/75 not-dark:hidden sm:hidden" />
              <img src="/oatmeal/img/screenshots/1-left-1800-top-660.webp" alt="" width="1800" height="660" class="bg-white/75 max-sm:hidden lg:hidden dark:hidden" />
              <img src="/oatmeal/img/screenshots/1-color-olive-left-1800-top-660.webp" alt="" width="1800" height="660" class="bg-black/75 not-dark:hidden max-sm:hidden lg:hidden" />
              <img src="/oatmeal/img/screenshots/1-left-1300-top-1300.webp" alt="" width="1300" height="1300" class="bg-white/75 max-lg:hidden xl:hidden dark:hidden" />
              <img src="/oatmeal/img/screenshots/1-color-olive-left-1300-top-1300.webp" alt="" width="1300" height="1300" class="bg-black/75 not-dark:hidden max-lg:hidden xl:hidden" />
              <img src="/oatmeal/img/screenshots/1-left-1800-top-1250.webp" alt="" width="1800" height="1250" class="bg-white/75 max-xl:hidden dark:hidden" />
              <img src="/oatmeal/img/screenshots/1-color-olive-left-1800-top-1250.webp" alt="" width="1800" height="1250" class="bg-black/75 not-dark:hidden max-xl:hidden" />
            </Screenshot>
          </div>
          <div class="flex flex-col gap-4 p-6 sm:p-10 lg:p-6">
            <div><h3 class="text-base/8 font-medium text-olive-950 dark:text-white">Shared Inbox</h3><div class="mt-2 flex flex-col gap-4 text-sm/7 text-olive-700 dark:text-olive-400"><p>Keep every customer conversation in one clean, collaborative inbox. A single source of truth is much easier to ignore.</p></div></div>
            <a href="#" class="inline-flex items-center gap-2 text-sm/7 font-medium text-olive-950 dark:text-white">See how it works <svg width="13" height="7" viewBox="0 0 13 7" fill="none" stroke-width="1" class="inline-block"><path d="M12.5049 3.49512L.504883 3.49512" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 6.5L12.5 3.5L9.5.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
          </div>
        </div>
        <div class="rounded-lg bg-olive-950/2.5 p-2 dark:bg-white/5">
          <div class="relative overflow-hidden rounded-sm dark:after:absolute dark:after:inset-0 dark:after:rounded-sm dark:after:outline-1 dark:after:-outline-offset-1 dark:after:outline-white/10">
            <Screenshot wallpaper="blue" placement="bottom-left">
              <img src="/oatmeal/img/screenshots/1-right-1000-top-800.webp" alt="" width="1000" height="800" class="bg-white/75 sm:hidden dark:hidden" />
              <img src="/oatmeal/img/screenshots/1-color-olive-right-1000-top-800.webp" alt="" width="1000" height="800" class="bg-black/75 not-dark:hidden sm:hidden" />
              <img src="/oatmeal/img/screenshots/1-right-1800-top-660.webp" alt="" width="1800" height="660" class="bg-white/75 max-sm:hidden lg:hidden dark:hidden" />
              <img src="/oatmeal/img/screenshots/1-color-olive-right-1800-top-660.webp" alt="" width="1800" height="660" class="bg-black/75 not-dark:hidden max-sm:hidden lg:hidden" />
              <img src="/oatmeal/img/screenshots/1-right-1300-top-1300.webp" alt="" width="1300" height="1300" class="bg-white/75 max-lg:hidden xl:hidden dark:hidden" />
              <img src="/oatmeal/img/screenshots/1-color-olive-right-1300-top-1300.webp" alt="" width="1300" height="1300" class="bg-black/75 not-dark:hidden max-lg:hidden xl:hidden" />
              <img src="/oatmeal/img/screenshots/1-right-1800-top-1250.webp" alt="" width="1800" height="1250" class="bg-white/75 max-xl:hidden dark:hidden" />
              <img src="/oatmeal/img/screenshots/1-color-olive-right-1800-top-1250.webp" alt="" width="1800" height="1250" class="bg-black/75 not-dark:hidden max-xl:hidden" />
            </Screenshot>
          </div>
          <div class="flex flex-col gap-4 p-6 sm:p-10 lg:p-6">
            <div><h3 class="text-base/8 font-medium text-olive-950 dark:text-white">Inbox Agent</h3><div class="mt-2 flex flex-col gap-4 text-sm/7 text-olive-700 dark:text-olive-400"><p>Get valuable context without having to read through your customer's long, angry email thread.</p></div></div>
            <a href="#" class="inline-flex items-center gap-2 text-sm/7 font-medium text-olive-950 dark:text-white">See how it works <svg width="13" height="7" viewBox="0 0 13 7" fill="none" stroke-width="1" class="inline-block"><path d="M12.5049 3.49512L.504883 3.49512" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 6.5L12.5 3.5L9.5.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- StatsWithGraph -->
  <section id="stats" class="py-16">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 sm:gap-16 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex max-w-2xl flex-col gap-6">
        <div class="flex flex-col gap-2"><div class="text-sm/7 font-semibold text-olive-700 dark:text-olive-400">Built for scale</div><h2 class="font-display text-3xl/9 font-medium tracking-[-0.03em] text-pretty text-olive-950 sm:text-[2.5rem]/10 dark:text-white">The inbox powering customer conversations everywhere.</h2></div>
        <div class="text-base/7 text-pretty text-olive-700 dark:text-olive-400"><p>Oatmeal helps teams deliver personal, organized, and fast customer support across the world. From small startups to enterprise teams, we process millions of messages each month — using a massive network of low wage workers stationed around the globe.</p></div>
      </div>
      <div>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
          <div class="col-span-2 grid grid-cols-2 gap-x-2 gap-y-10 sm:auto-cols-fr sm:grid-flow-col-dense">
            <div class="border-l border-olive-950/20 pl-6 dark:border-white/20"><div class="text-2xl/10 tracking-tight text-olive-950 dark:text-white">2M+</div><p class="mt-2 text-sm/7 text-olive-700 dark:text-olive-400">Emails manually processed every week across thousands of teams.</p></div>
            <div class="border-l border-olive-950/20 pl-6 dark:border-white/20"><div class="text-2xl/10 tracking-tight text-olive-950 dark:text-white">99.98%</div><p class="mt-2 text-sm/7 text-olive-700 dark:text-olive-400">Uptime — because your customers never stop complaining.</p></div>
          </div>
        </div>
        <div class="pointer-events-none relative h-48 sm:h-64 lg:h-36">
          <div class="absolute bottom-0 left-1/2 w-[150vw] max-w-[calc(var(--container-7xl)-(--spacing(10)*2))] -translate-x-1/2">
            <svg class="h-100 w-full fill-olive-950/2.5 stroke-olive-950/40 dark:fill-white/2.5 dark:stroke-white/40" viewBox="0 0 1200 400" preserveAspectRatio="none">
              <defs><clipPath id="stats-path"><path d="M 0 400 L 0 383 C 396 362.7936732276819, 804 264.31672304481856, 1200 60 L 1200 60 L 1200 400 Z"></path></clipPath></defs>
              <path d="M 0 400 L 0 383 C 396 362.7936732276819, 804 264.31672304481856, 1200 60 L 1200 60 L 1200 400 Z" stroke="none"></path>
              <g stroke-width="1" stroke-dasharray="4 3" clip-path="url(#stats-path)">
                {[0.5, 92.3, 184.6, 276.9, 369.2, 461.5, 553.8, 646.1, 738.4, 830.7, 923, 1015.3, 1107.6, 1199.5].map((x) => <line x1={x} y1="400" x2={x} y2="0" vector-effect="non-scaling-stroke"></line>)}
              </g>
              <path d="M 0 383 C 396 362.7936732276819, 804 264.31672304481856, 1200 60" fill="none" stroke-width="1" vector-effect="non-scaling-stroke"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TestimonialThreeColumnGrid -->
  <section id="testimonial" class="py-16">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 sm:gap-16 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex max-w-2xl flex-col gap-6">
        <div class="flex flex-col gap-2"><h2 class="font-display text-3xl/9 font-medium tracking-[-0.03em] text-pretty text-olive-950 sm:text-[2.5rem]/10 dark:text-white">What our customers are saying</h2></div>
        <div class="text-base/7 text-pretty text-olive-700 dark:text-olive-400"><p>We've given these customers a significant discount in exchange for their honest reviews.</p></div>
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {testimonials.map(([quote, avatar, name, byline]) => <TestimonialCard quote={quote} image={`/oatmeal/img/avatars/${avatar}-size-160.webp`} name={name} byline={byline} />)}
      </div>
    </div>
  </section>

  <!-- FAQsTwoColumnAccordion -->
  <section id="faqs" class="py-16">
    <div class="mx-auto grid w-full max-w-2xl grid-cols-1 gap-x-2 gap-y-8 px-6 md:max-w-3xl lg:max-w-7xl lg:grid-cols-2 lg:px-10">
      <div class="flex flex-col gap-6"><h2 class="font-display text-3xl/9 font-medium tracking-[-0.03em] text-pretty text-olive-950 sm:text-[2.5rem]/10 dark:text-white">Questions & Answers</h2></div>
      <div class="divide-y divide-olive-950/10 border-y border-olive-950/10 dark:divide-white/10 dark:border-white/10">
        {faqs.map(([question, answer], index) => (
          <details id={`faq-${index + 1}`} class="group">
            <summary class="flex w-full cursor-pointer list-none items-start justify-between gap-6 py-4 text-left text-base/7 text-olive-950 dark:text-white">
              {question}
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1" class="h-lh shrink-0 group-open:hidden"><path d="M6.5.5v12M12.5 6.5H.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              <svg width="13" height="1" viewBox="0 0 13 1" fill="none" stroke="currentColor" stroke-width="1" class="hidden h-lh shrink-0 group-open:inline"><path d="M12.505.5h-12" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </summary>
            <div class="-mt-2 flex flex-col gap-2 pr-12 pb-4 text-sm/7 text-olive-700 dark:text-olive-400">{answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- PricingMultiTier -->
  <section id="pricing" class="py-16">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 sm:gap-16 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex max-w-2xl flex-col gap-6"><div class="flex flex-col gap-2"><h2 class="font-display text-3xl/9 font-medium tracking-[-0.03em] text-pretty text-olive-950 sm:text-[2.5rem]/10 dark:text-white">Pricing to fit your business needs.</h2></div></div>
      <div class="grid grid-cols-1 gap-2 sm:has-[>:nth-child(5)]:grid-cols-2 sm:max-lg:has-[>:last-child:nth-child(even)]:grid-cols-2 lg:auto-cols-fr lg:grid-flow-col lg:grid-cols-none lg:has-[>:nth-child(5)]:grid-flow-row lg:has-[>:nth-child(5)]:grid-cols-3">
        {plans.map(([name, price, description, features]) => (
          <div class="flex flex-col justify-between gap-6 rounded-xl bg-olive-950/2.5 p-6 sm:items-start dark:bg-white/5">
            <div class="self-stretch">
              <div class="flex items-center justify-between">
                {name === "Growth" && <div class="order-last inline-flex rounded-full bg-olive-950/10 px-2 text-xs/6 font-medium text-olive-950 dark:bg-white/10 dark:text-white">Most popular</div>}
                <h3 class="text-2xl/8 tracking-tight text-olive-950 dark:text-white">{name}</h3>
              </div>
              <p class="mt-1 inline-flex gap-1 text-base/7"><span class="text-olive-950 dark:text-white">{price}</span><span class="text-olive-500 dark:text-olive-500">/mo</span></p>
              <div class="mt-4 flex flex-col gap-4 text-sm/6 text-olive-700 dark:text-olive-400"><p>{description}</p></div>
              <ul class="mt-4 space-y-2 text-sm/6 text-olive-700 dark:text-olive-400">
                {(features as string[]).map((feature) => <li class="flex gap-4"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1" class="h-lh shrink-0 stroke-olive-950 dark:stroke-white"><path d="M1.5 6.5L5.5 11.5L11.5 1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg><p>{feature}</p></li>)}
              </ul>
            </div>
            <a href="#" class:list={["inline-flex shrink-0 items-center justify-center gap-1 rounded-full px-4 py-2 text-sm/7 font-medium", name === "Growth" ? "bg-olive-950 text-white hover:bg-olive-800 dark:bg-olive-300 dark:text-olive-950 dark:hover:bg-olive-200" : "bg-olive-950/10 text-olive-950 hover:bg-olive-950/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/20"]}>Start free trial</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CallToActionSimple -->
  <section id="call-to-action" class="py-16">
    <div class="mx-auto flex w-full max-w-2xl flex-col gap-10 px-6 md:max-w-3xl lg:max-w-7xl lg:px-10">
      <div class="flex flex-col gap-6">
        <div class="flex max-w-4xl flex-col gap-2"><h2 class="font-display text-3xl/9 font-medium tracking-[-0.03em] text-pretty text-olive-950 sm:text-[2.5rem]/10 dark:text-white">Ready to make customer support feel simple again?</h2></div>
        <div class="flex max-w-3xl flex-col gap-4 text-base/7 text-pretty text-olive-700 dark:text-olive-400"><p>Join hundreds of teams using Oatmeal to deliver faster, friendlier email support — using a massive network of low wage workers stationed around the globe</p></div>
      </div>
      <div class="flex items-center gap-4">
        <a href="#" class="inline-flex shrink-0 items-center justify-center gap-1 rounded-full bg-olive-950 px-4 py-2 text-sm/7 font-medium text-white hover:bg-olive-800 dark:bg-olive-300 dark:text-olive-950 dark:hover:bg-olive-200">Start free trial</a>
