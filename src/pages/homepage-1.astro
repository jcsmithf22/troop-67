---
import { Image } from "astro:assets";
import scouts from "@/images/scouts.jpg";
import dusk from "@/images/dusk.jpg";
import meeting from "@/images/meeting.webp";

import OatmealLayout from "@/layouts/OatmealLayout.astro";

import ButtonLink from "@/components/elements/button-link.astro";
import Link from "@/components/elements/link.astro";
import PlainButtonLink from "@/components/elements/plain-button-link.astro";
import Photo from "@/components/elements/photo.astro";
import ArrowNarrowRightIcon from "@/components/icons/arrow-narrow-right-icon.astro";
import ChevronIcon from "@/components/icons/chevron-icon.astro";
import CallToActionSimple from "@/components/sections/call-to-action-simple.astro";
import Faq from "@/components/sections/faq.astro";
import FAQsTwoColumnAccordion from "@/components/sections/faqs-two-column-accordion.astro";
import Feature from "@/components/sections/feature.astro";
import FeaturesTwoColumnWithDemos from "@/components/sections/features-two-column-with-demos.astro";
import HeroLeftAlignedWithDemo from "@/components/sections/hero-left-aligned-with-demo.astro";
---

<OatmealLayout>
  <!-- Hero -->
  <HeroLeftAlignedWithDemo
    id="hero"
    headline="Forge your path. Determine your future. Embrace leadership."
    class="pt-22"
  >
    <p slot="subheadline">
      Since 1966, Troop 67 has provided a rich Scouting experience through a
      three pronged program. Weekly meetings provide foundational leadership and
      learning opportunities. Monthly campouts offer the platform to put
      abilities into practice. Every year we spend a week at a rustic summer
      camp, a week at Council Camp, and go on a High Adventure. Come be a part
      of one of the most active Troops in the Appleton Area!
    </p>
    <div slot="cta" class="flex items-center gap-4">
      <ButtonLink href="#" size="lg">Start your journey</ButtonLink>
      <PlainButtonLink href="#" size="lg"
        >View our schedule <ArrowNarrowRightIcon /></PlainButtonLink
      >
    </div>
    <Fragment slot="demo">
      <Photo class="lg:hidden">
        <Image
          src={scouts}
          alt="Scouts from Troop 67"
          class="h-auto w-full"
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </Photo>
      <Photo class="max-lg:hidden">
        <Image
          src={scouts}
          alt="Scouts from Troop 67"
          class="h-auto w-full"
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </Photo>
    </Fragment>
  </HeroLeftAlignedWithDemo>

  <!-- Features -->
  <FeaturesTwoColumnWithDemos
    id="features"
    headline="Everything you need to deliver personal, organized, and delightful support."
  >
    <p slot="subheadline">
      Rally behind the genius of Scoutmaster Christopher Allen. Your boys will
      reach new heights in leadership, teamwork, physics knowledge, and personal
      growth. They will also attend University of Wisconsin, Madison someday.
    </p>
    <Fragment slot="features">
      <Feature headline="Camping adventures">
        <Photo slot="demo">
          <Image
            src={dusk}
            alt="Scouts on an adventure"
            class="h-auto w-full"
            densities={[1, 2]}
          />
        </Photo>
        <p slot="subheadline">
          Every month, scouts get the opportunity to put the skills they learn
          into practice. Once a year we spend a week at a rustic summer camp, a
          week at Council Camp, and go on a High Adventure.
        </p>
      </Feature>
      <Feature headline="Weekly meetings">
        <Photo slot="demo">
          <Image
            src={meeting}
            alt="Scouts in a meeting"
            class="h-auto w-full"
            densities={[1, 2]}
          />
        </Photo>
        <p slot="subheadline">
          We believe the scouts should be part of the process of running the
          troop, preparing them to be future leaders in the organization.
        </p>
        <Link slot="cta" href="#"
          >View the schedule<ArrowNarrowRightIcon /></Link
        >
      </Feature>
    </Fragment>
  </FeaturesTwoColumnWithDemos>

  <!-- FAQs -->
  <FAQsTwoColumnAccordion id="faqs" headline="Questions & Answers">
    <Faq
      id="faq-1"
      question="Do I need a credit card to start the free trial?"
      answer="Yes, but don't worry, you won't be charged until the trial period is over. We won't send you an email reminding you when this happens because we are really hoping you'll forget and we can keep charging you until your cards expires"
    />
    <Faq
      id="faq-2"
      question="Can my whole team use the same inbox?"
      answer="Yes, the more the merrier! Oatmeal works best when your entire company has access. We will charge you per additional seat, but we won't tell you about this until you get your invoice."
    />
    <Faq
      id="faq-3"
      question="Is the AI agent actually a bunch of people in India?"
      answer="Not just India! We have people in lots of countries around the world pretending to be an AI, including some that are currently under sanctions, so we can't legally mention them here."
    />
    <Faq
      id="faq-4"
      question="Does Oatmeal replace my email client?"
      answer="Absolutely. The idea is that we transition you away from email entirely, so you become completely dependent on our service. Like a parasite living off a host."
    />
  </FAQsTwoColumnAccordion>

  <!-- Call To Action -->
  <CallToActionSimple
    id="call-to-action"
    headline="Become a part of one of the most active Troops in the Appleton Area!"
  >
    <p slot="subheadline">
      Join hundreds of teams using Oatmeal to deliver faster, friendlier email
      support — using a massive network of low wage workers stationed around the
      globe
    </p>
    <div slot="cta" class="flex items-center gap-4">
      <ButtonLink href="#" size="lg">Start free trial</ButtonLink>
      <PlainButtonLink href="#" size="lg"
        >Book a demo <ChevronIcon /></PlainButtonLink
      >
    </div>
  </CallToActionSimple>
</OatmealLayout>
