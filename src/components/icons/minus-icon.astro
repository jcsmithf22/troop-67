---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  width="13"
  height="1"
  viewBox="0 0 13 1"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  role="img"
  class:list={["inline-block", className]}
>
  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M12.505.5h-12"></path>
</svg>
