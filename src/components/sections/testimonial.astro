---
interface Props {
  name: string;
  byline: string;
  class?: string;
}

const { name, byline, class: className } = Astro.props;
---

<figure
  class:list={[
    "flex flex-col justify-between gap-10 rounded-md bg-olive-950/2.5 p-6 text-sm/7 text-olive-950 dark:bg-white/5 dark:text-white",
    className,
  ]}
>
  <blockquote
    class="relative flex flex-col gap-4 *:first:before:absolute *:first:before:inline *:first:before:-translate-x-full *:first:before:content-['\u201C'] *:last:after:inline *:last:after:content-['\u201D']"
  >
    <slot name="quote" />
  </blockquote>
  <figcaption class="flex items-center gap-4">
    <div
      class="flex size-12 overflow-hidden rounded-full outline -outline-offset-1 outline-black/5 *:size-full *:object-cover dark:outline-white/5"
    >
      <slot name="img" />
    </div>
    <div>
      <p class="font-semibold">{name}</p>
      <p class="text-olive-700 dark:text-olive-400">{byline}</p>
    </div>
  </figcaption>
</figure>
