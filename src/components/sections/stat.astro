---
interface Props {
  stat: string;
  text: string;
  class?: string;
}

const { stat, text, class: className } = Astro.props;
---

<div class:list={["border-l border-olive-950/20 pl-6 dark:border-white/20", className]}>
  <div class="text-2xl/10 tracking-tight text-olive-950 dark:text-white">{stat}</div>
  <p class="mt-2 text-sm/7 text-olive-700 dark:text-olive-400">{text}</p>
</div>
