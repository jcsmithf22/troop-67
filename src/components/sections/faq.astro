---
import MinusIcon from "@/components/icons/minus-icon.astro";
import PlusIcon from "@/components/icons/plus-icon.astro";

interface Props {
  id: string;
  question: string;
  answer: string;
}

const { id, question, answer } = Astro.props;
---

<details id={id} class="group">
  <summary
    id={`${id}-question`}
    class="flex w-full cursor-pointer list-none items-start justify-between gap-6 py-4 text-left text-base/7 text-olive-950 dark:text-white [&::-webkit-details-marker]:hidden"
  >
    {question}
    <PlusIcon class="h-lh group-open:hidden" />
    <MinusIcon class="h-lh hidden group-open:inline" />
  </summary>
  <div class="-mt-2 flex flex-col gap-2 pr-12 pb-4 text-sm/7 text-olive-700 dark:text-olive-400">
    {answer}
  </div>
</details>
