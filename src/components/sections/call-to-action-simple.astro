---
import Container from "@/components/elements/container.astro";
import Eyebrow from "@/components/elements/eyebrow.astro";
import Subheading from "@/components/elements/subheading.astro";
import Text from "@/components/elements/text.astro";

interface Props {
  id?: string;
  eyebrow?: string;
  headline: string;
  class?: string;
}

const { id, eyebrow, headline, class: className } = Astro.props;
---

<section id={id} class:list={["py-16", className]}>
  <Container class="flex flex-col gap-10">
    <div class="flex flex-col gap-6">
      <div class="flex max-w-4xl flex-col gap-2">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <Subheading>{headline}</Subheading>
      </div>
      {
        Astro.slots.has("subheadline") && (
          <Text class="flex max-w-3xl flex-col gap-4 text-pretty">
            <slot name="subheadline" />
          </Text>
        )
      }
    </div>
    <slot name="cta" />
  </Container>
</section>
