---
import "@/styles/oatmeal.css";
import { Font, Image } from "astro:assets";
import scoutLogo from "@/images/scout_color.png";

import ButtonLink from "@/components/elements/button-link.astro";
import Main from "@/components/elements/main.astro";
import PlainButtonLink from "@/components/elements/plain-button-link.astro";
import GitHubIcon from "@/components/icons/social/github-icon.astro";
import XIcon from "@/components/icons/social/x-icon.astro";
import YouTubeIcon from "@/components/icons/social/youtube-icon.astro";
import FooterCategory from "@/components/sections/footer-category.astro";
import FooterLink from "@/components/sections/footer-link.astro";
import FooterWithNewsletterFormCategoriesAndSocialIcons from "@/components/sections/footer-with-newsletter-form-categories-and-social-icons.astro";
import NavbarLink from "@/components/sections/navbar-link.astro";
import NavbarLogo from "@/components/sections/navbar-logo.astro";
import NavbarWithLogoAndRightAlignedLinksAndActions from "@/components/sections/navbar-with-logo-and-right-aligned-links-and-actions.astro";
import NewsletterForm from "@/components/sections/newsletter-form.astro";
import SocialLink from "@/components/sections/social-link.astro";

interface Props {
  title?: string;
}

const { title = "Oatmeal Kit Demo" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f1f0ec" />
    <Font cssVariable="--font-familjen-grotesk" preload />
    <Font cssVariable="--font-inter" preload />
    <title>{title}</title>
  </head>
  <body>
    <NavbarWithLogoAndRightAlignedLinksAndActions id="navbar">
      <NavbarLogo slot="logo" href="/">
        <span class="inline-flex items-center gap-2 text-sm/7 font-medium text-olive-950 dark:text-white">
          <Image src={scoutLogo} alt="" width={36} densities={[1, 2]} class="h-9 w-auto object-contain" />
          <span class="pb-1 font-display text-2xl/7 tracking-tighter">Appleton Troop 67</span>
        </span>
      </NavbarLogo>
      <Fragment slot="links">
        <NavbarLink href="#">Our Troop</NavbarLink>
        <NavbarLink href="#">Calendar</NavbarLink>
      </Fragment>
    </NavbarWithLogoAndRightAlignedLinksAndActions>

    <Main>
      <slot />
    </Main>

    <FooterWithNewsletterFormCategoriesAndSocialIcons id="footer" fineprint="© 2025 Oatmeal, Inc.">
      <NewsletterForm slot="cta" headline="Stay in the loop" action="#">
        <p slot="subheadline">
          Get customer support tips, product updates and customer stories that you can archive as soon as they arrive.
        </p>
      </NewsletterForm>
      <Fragment slot="links">
        <FooterCategory title="Product">
          <FooterLink href="#">Features</FooterLink>
          <FooterLink href="#">Pricing</FooterLink>
          <FooterLink href="#">Integrations</FooterLink>
        </FooterCategory>
        <FooterCategory title="Company">
          <FooterLink href="#">About</FooterLink>
          <FooterLink href="#">Careers</FooterLink>
          <FooterLink href="#">Blog</FooterLink>
          <FooterLink href="#">Press Kit</FooterLink>
        </FooterCategory>
        <FooterCategory title="Resources">
          <FooterLink href="#">Help Center</FooterLink>
          <FooterLink href="#">API Docs</FooterLink>
          <FooterLink href="#">Status</FooterLink>
          <FooterLink href="#">Contact</FooterLink>
        </FooterCategory>
        <FooterCategory title="Legal">
          <FooterLink href="#">Privacy Policy</FooterLink>
          <FooterLink href="#">Terms of Service</FooterLink>
          <FooterLink href="#">Security</FooterLink>
        </FooterCategory>
      </Fragment>
      <Fragment slot="socialLinks">
        <SocialLink href="https://x.com" name="X">
          <XIcon />
        </SocialLink>
        <SocialLink href="https://github.com" name="GitHub">
          <GitHubIcon />
        </SocialLink>
        <SocialLink href="https://www.youtube.com" name="YouTube">
          <YouTubeIcon />
        </SocialLink>
      </Fragment>
    </FooterWithNewsletterFormCategoriesAndSocialIcons>
  </body>
</html>
